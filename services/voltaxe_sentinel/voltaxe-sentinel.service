[Unit]
Description=Voltaxe Sentinel - Advanced Rootkit Detection Engine
Documentation=https://docs.voltaxe.com/sentinel
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/voltaxe_sentinel --daemon --interval 6h --verbose
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/voltaxe

# Resource limits
LimitNOFILE=8192
MemoryMax=256M
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voltaxe-sentinel

[Install]
WantedBy=multi-user.target